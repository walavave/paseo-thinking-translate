{
  "name": "paseo-thinking-translate",
  "version": "0.1.0",
  "private": true,
  "description": "Translate reasoning into Chinese with Google Translate and preserve Markdown.",
  "license": "MIT",
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "README.md",
    "OVERVIEW.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint index.client.tsx index.server.ts client server shared scripts tests",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --bail=1",
    "verify:host": "node scripts/verify-host.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:google": "node scripts/verify-google.mjs"
  },
  "dependencies": {
    "@lezer/common": "1.5.2",
    "@lezer/markdown": "1.6.4",
    "decode-named-character-reference": "1.3.0"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.11.4",
    "@tanstack/react-query": "5.90.11",
    "@types/node": "24.10.1",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "esbuild": "0.28.1",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "playwright": "1.56.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "0.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.6",
    "zod": "4.4.3"
  }
}
